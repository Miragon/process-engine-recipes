<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_review" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="review-process" name="Review" isExecutable="true">
    <bpmn:startEvent id="start" />
    <bpmn:sequenceFlow id="toReview" sourceRef="start" targetRef="review" />
    <bpmn:userTask id="review" name="Review document">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="review@1" />
        <zeebe:assignmentDefinition candidateGroups="sales" />
        <zeebe:taskHeaders>
          <zeebe:header key="domain" value="review" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="toReviewed" sourceRef="review" targetRef="reviewed" />
    <bpmn:endEvent id="reviewed" />
    <bpmn:boundaryEvent id="withdrawn" attachedToRef="review">
      <bpmn:messageEventDefinition messageRef="reviewWithdrawn" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="toWithdrawnEnd" sourceRef="withdrawn" targetRef="withdrawnEnd" />
    <bpmn:endEvent id="withdrawnEnd" />
  </bpmn:process>
  <bpmn:message id="reviewWithdrawn" name="ReviewWithdrawn">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=documentId" />
    </bpmn:extensionElements>
  </bpmn:message>
</bpmn:definitions>
